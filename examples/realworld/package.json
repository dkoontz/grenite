{
  "name": "grenite-realworld-example",
  "version": "1.0.0",
  "private": true,
  "description": "Grenite implementation of the RealWorld backend API, backed by Supabase Postgres via Docker.",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:clean": "docker compose down -v",
    "build": "mkdir -p build && gren make Main --output=build/main.js",
    "start": "node main.js",
    "test": "./hurl/run-hurl-tests.sh",
    "clean": "rm -rf build gren_packages"
  },
  "dependencies": {
    "postgres": "^3.4.5"
  }
}
