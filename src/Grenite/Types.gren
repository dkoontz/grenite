module Grenite.Types exposing (Application, InitContext, Request, Response, RouteConfig, RouteHandler(..))

import Array exposing (Array)
import Dict exposing (Dict)
import Grenite.Http
import HttpServer
import HttpClient
import Node exposing (Environment)
import Task exposing (Task)
import Url exposing (Url)


{-| What the framework hands to `Application.init`. Besides the Node
environment, it carries the two values an application cannot produce on its
own: the permission for outbound HTTP requests, and the process environment
variables (for reading URLs and secrets at startup).
-}
type alias InitContext =
    { environment : Environment
    , httpPermission : HttpClient.Permission
    , variables : Dict String String
    }


{-| Given a set of routes and functions for initializing a shared server state,
handling errors and the not found route, this type represents the HTTP server application.
Use `Grenite.createServer` to create an instance of this type.
Use `Grenite.createRoute` to create individual routes.

    exampleApp : Grenite.Types.Application AppModel Error
    exampleApp =
        { host = "0.0.0.0"
        , port_ = 3000
        , routes = [ getUserRoute, createUserRoute ]
        , notFoundHandler =
            \_ ->
                { status = 404
                , body = "{\"error\": \"Not Found\"}"
                , headers = []
                }
        , errorHandler = handleError
        , init = \_ -> {}
        }

-}
type alias Application appModel appError =
    { host : String
    , port_ : Int
    , routes : Array (RouteHandler appModel appError)
    , notFoundHandler : HttpServer.Request -> Response String
    , errorHandler : appError -> Response String
    , init : InitContext -> appModel
    }


type alias Response responseType =
    { status : Int
    , body : responseType
    , headers : Array Grenite.Http.ResponseHeader
    }


type alias Request routeParams requestBodyData =
    { url : Url
    , headers : Array Grenite.Http.RequestHeader
    , params : routeParams
    , body : requestBodyData
    }


type RouteHandler appModel appError
    = RouteHandler
        { method : HttpServer.Method
        , matcher : appModel -> HttpServer.Request -> Maybe (Result String (Task appError (Response String)))
        }


type alias RouteConfig appModel appError routeParams requestBody responseBody =
    { method : HttpServer.Method
    , route : String -> Maybe (Result String routeParams)
    , requestDecoder : String -> Result String requestBody
    , responseEncoder : responseBody -> String
    , handler : appModel -> Request routeParams requestBody -> Task appError (Response responseBody)
    }
